FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;
}

gradSchemes
{
    default         Gauss linear;
    //grad(U)         cellMDLimited leastSquares 0.5;
    //grad(U)	    cellLimited Gauss linear 1;
    limitedGrad     cellLimited Gauss linear 1;
}

divSchemes
{
    default             none;

    div(rhoPhi,U)       bounded Gauss linearUpwind limitedGrad;
    div(phi,alpha)      Gauss vanLeer01;
    div(phirb,alpha)    Gauss interfaceCompression;

    "div\(phi,(k|omega)\)"      bounded Gauss upwind;
    "div\(rhoPhi,(k|omega)\)"      bounded Gauss upwind;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
}

laplacianSchemes
{
    default         Gauss linear limited corrected 0.333;
}

interpolationSchemes
{
    default         linear;
}

snGradSchemes
{
    default         limited corrected 0.333;
}

wallDist
{
    method          meshWave;
    //nRequired       true;
}

fluxRequired
{
    default         no;
    p_rgh;
    pcorr;
    alpha.,water;
}

