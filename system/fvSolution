FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    "alpha.air.*"
    {
        nAlphaCorr      2;
        nAlphaSubCycles 2;
        cAlpha          0;

        MULESCorr       yes;
        nLimiterIter    3;

        reconstructionScheme plicRDF;
        vof2IsoTol      1e-8;
        surfCellTol     1e-6;
        nAlphaBounds    3;
        snapTol         1e-12;
        clip            true;

        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0;
    }

    "pcorr.*"
    {
        solver          PCG;
        preconditioner
        {
            preconditioner  GAMG;
            tolerance       1e-5;
            relTol          0;
            smoother        GaussSeidel;
        }
        tolerance       1e-5;
        relTol          0;
        maxIter         50;
    }

    p_rgh
{
    solver           GAMG;
    tolerance        1e-6;     // was 5e-9
    relTol           0.05;     // was 0.01
    smoother         GaussSeidel;
    maxIter          30;
    cacheAgglomeration  true;
    agglomerator        faceAreaPair;
    nCellsInCoarsestLevel 100;
    mergeLevels         1;
}

p_rghFinal
{
    $p_rgh;
    tolerance       1e-7;      // was 5e-9
    relTol          0;
}

    "(U|k|omega|s).*"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        nSweeps         1;
        tolerance       1e-6;
        relTol          0.1;
    };
}

PIMPLE
{
    consistent        yes;
    momentumPredictor yes;
    nCorrectors     2;
    nOuterCorrectors 1;
    nNonOrthogonalCorrectors 2;
}


